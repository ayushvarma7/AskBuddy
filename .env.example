# MeetingScribe Environment Configuration

# LLM Provider Configuration
# See docs/cuga-env-api-keys.md for provider-specific examples

# OpenAI
# AGENT_SETTING_CONFIG=openai
# MODEL_NAME=gpt-4o
# OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (used by Ask Buddy)
# AGENT_SETTING_CONFIG=settings.google.toml
# MODEL_NAME=gemini-2.5-flash
# GOOGLE_API_KEY=your-google-api-key-here

# Or use Groq (fast, free tier available)
# AGENT_SETTING_CONFIG=groq
# MODEL_NAME=llama-3.3-70b-versatile
# GROQ_API_KEY=your-groq-api-key-here

# Tavily Web Search
TAVILY_API_KEY=your-tavily-api-key

# MCP Server Credentials (for live execution)
# Uncomment and configure when moving from dry-run to live mode

# Linear Task Tracker
# LINEAR_API_KEY=your-linear-api-key

# Slack
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_TEAM_ID=your-slack-team-id

# Google Calendar
# GOOGLE_CALENDAR_CREDENTIALS=/path/to/credentials.json

# Asana (alternative to Linear)
# ASANA_ACCESS_TOKEN=your-asana-token

# Jira (alternative to Linear)
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USERNAME=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token

# ─── Ask Buddy — HR RAG Bot for Slack ───────────────────────────────────────

# Slack Bot credentials (from api.slack.com/apps)
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN=xapp-your-app-level-token

# Postgres + pgvector connection string
# Format: postgresql://user:password@host:port/database
# Default when using docker-compose.askbuddy.yml:
# ASK_BUDDY_DB_DSN=postgresql://askbuddy:askbuddy_secret@localhost:5432/askbuddy

# Channel id for the weekly feedback digest (python -m src.ask_buddy.feedback_digest)
# ASK_BUDDY_DIGEST_CHANNEL=C0123ABCD

# Optional: inject N highest-rated past answers as few-shot examples into the
# agent's system prompt. 0 / unset = off (default). Set to "auto" to let the
# bot self-tune the count as it accumulates positively-rated answers.
# ASK_BUDDY_FEWSHOT=auto

# ── Self-tuning loop — nightly LLM-as-judge eval (point 4) ───────────────────
# Replays tests/regression_evals.json through live retrieval, grades each with
# a Gemini judge, and posts a pass-rate + regression-delta summary. Disabled
# automatically unless a curated regression_evals.json exists.
# Channel to post the eval summary to (falls back to ASK_BUDDY_DIGEST_CHANNEL
# then GIT_WATCH_CHANNEL).
# ASK_BUDDY_EVAL_CHANNEL=C0123ABCD
# Cron + timezone for the nightly run (default: 03:00 America/Los_Angeles).
# ASK_BUDDY_EVAL_CRON=0 3 * * *
# ASK_BUDDY_EVAL_TIMEZONE=America/Los_Angeles

# ── Git Agent ────────────────────────────────────────────────────────────────

# Fine-grained PAT, read-only scopes (Issues/PRs/Metadata/Checks).
# Create at: GitHub → Settings → Developer settings → Fine-grained tokens
# GITHUB_TOKEN=github_pat_...

# Base API URL. Leave as-is for github.com; change only for GitHub Enterprise.
# GITHUB_API_URL=https://api.github.com

# Proactive triage config (comma-separated "owner/repo" list). Empty = triage off.
# GIT_WATCH_REPOS=acme-corp/backend,acme-corp/frontend

# Slack channel (name or ID) where triage summaries are posted.
# GIT_WATCH_CHANNEL=eng-triage

# Poll interval in minutes for the triage watcher (default: 5).
# GIT_WATCH_INTERVAL_MINUTES=5

# Daily digest schedule — full open/closed issue + PR summary posted to GIT_WATCH_CHANNEL.
# Option A: simple time(s) — post at these times every day (comma-separate for multiple).
# GIT_DIGEST_TIMES=9:00
# GIT_DIGEST_TIMES=9:00,17:00

# Option B: full 5-field cron expression (used if GIT_DIGEST_TIMES is not set).
# Default: 9 AM every day.
# GIT_DIGEST_CRON=0 9 * * *

# Timezone for the digest schedule (IANA name). Default: America/Los_Angeles.
# GIT_DIGEST_TIMEZONE=America/Los_Angeles

# Optional: assume this repo when the user's question doesn't name one.
# GITHUB_DEFAULT_REPO=acme-corp/backend

# ── Stale-PR nudger (point 3) ────────────────────────────────────────────────
# DMs the human behind each requested reviewer (resolved via `/askbuddy link
# github`) when a non-draft PR has waited too long with no approval. Falls back
# to GIT_WATCH_CHANNEL when the reviewer isn't linked. Uses GIT_WATCH_REPOS.
# Age (days) after which an unreviewed PR is "stale" (default 3).
# GIT_STALE_PR_DAYS=3
# Don't re-nudge the same PR more often than this many hours (default 48).
# GIT_STALE_COOLDOWN_HOURS=48
# How often to scan for stale PRs, in hours (default 12).
# GIT_STALE_INTERVAL_HOURS=12

# ── Weekly per-user proactive digest (point 5) ───────────────────────────────
# DMs each linked user their PRs needing attention + a rotating policy
# spotlight. Uses GITHUB_TOKEN + GIT_WATCH_REPOS. Default: Monday 09:00 PT.
# ASK_BUDDY_PERSONAL_DIGEST_CRON=0 9 * * 1
# ASK_BUDDY_PERSONAL_DIGEST_TIMEZONE=America/Los_Angeles